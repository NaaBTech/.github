# Python bytecode from the validation scripts.
__pycache__/
*.py[cod]

# Node.js dependencies installed by npm.
node_modules/

# The cache that ruff writes when it runs.
.ruff_cache/
.pytest_cache/

# Working files of scripts/update_schemas.py.
# schemas/.naabtech-backups/ holds the per-transaction recovery copies. A backup
# that could not be restored is deliberately left there: it is the only
# recoverable copy of that file, and a later refresh must never overwrite it.
schemas/.naabtech-backups/
schemas/.naabtech-update.lock
schemas/.staging-*/

# Environment files and local credentials. The committed .env holds safe
# defaults and the committed .env.example is a template; everything else
# carries local values and is never committed.
.env.local
.env.local.php
.env.*.local
.env.dev
.env.prod
.env.production
.env.staging
# Private keys and local credential files.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
.secrets/
